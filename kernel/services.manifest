# Kernel service ABI (section 8.12). Each line maps a service name (the name a
# KLF Kira @Service wrapper exposes) to the platform-C linker symbol the running
# KIR calls via call.foreign. The VM resolves the symbol against the
# host-capability table (klf-vm::kernel_services); a native build links it from
# klf-native-rt.
#
#   <service-name>   <symbol>        <signature>

klf.io.put    klfsvc_io_put    (i32) -> i32     # write one byte, return it
klf.io.puti   klfsvc_io_puti   (i64) -> void    # write a decimal integer + newline
klf.io.write  klfsvc_io_write  (ptr, i64) -> i64 # write a byte buffer to the program output, return the count written
klf.io.write_error  klfsvc_io_write_error  (ptr, i64) -> i64 # write a byte buffer to the program error output, return the count written
klf.text.float  klfsvc_text_float  (i64, ptr, i64) -> i64 # f64 bits, destination, capacity -> shortest round-trip text length, copied only when it fits
klf.math.unary  klfsvc_math_unary  (i64, i64) -> i64 # operation, f64 bits -> f64 bits of the result
klf.math.binary  klfsvc_math_binary  (i64, i64, i64) -> i64 # operation, f64 bits of left and right -> result bits
klf.number  klfsvc_number  (i64, i64, i64, i64, i64) -> i64 # operation, left mantissa and scale, right mantissa and scale -> first word: mantissa, ordering, Int or f64 bits
klf.number.second  klfsvc_number_second  () -> i64 # second word of this thread's last klf.number answer: scale, or 32 + error code
klf.fs.read  klfsvc_fs_read  (ptr, i64, i64, ptr, i64) -> i64 # path, path length, offset, destination, count -> bytes read
klf.fs.write  klfsvc_fs_write  (ptr, i64, ptr, i64, i64) -> i64 # path, path length, bytes, count, append -> 1 when written
klf.fs.list  klfsvc_fs_list  (ptr, i64, ptr, i64) -> i64 # path, path length, destination, capacity -> length of NUL-ended names, copied only when they fit
klf.fs.file_exists  klfsvc_fs_file_exists  (ptr, i64) -> i64 # path, path length -> 1 for a regular file
klf.fs.path_exists  klfsvc_fs_path_exists  (ptr, i64) -> i64 # path, path length -> 1 for any entry
klf.fs.is_directory  klfsvc_fs_is_directory  (ptr, i64) -> i64 # path, path length -> 1 for a directory
klf.fs.file_size  klfsvc_fs_file_size  (ptr, i64) -> i64 # path, path length -> size in bytes, 0 when missing
klf.fs.make_directory  klfsvc_fs_make_directory  (ptr, i64) -> i64 # path, path length -> 1 when a directory is there afterwards
klf.fs.remove_path  klfsvc_fs_remove_path  (ptr, i64) -> i64 # path, path length -> 1 when removed
klf.fs.rename  klfsvc_fs_rename  (ptr, i64, ptr, i64) -> i64 # from, from length, to, to length -> 1 when renamed
klf.fs.open  klfsvc_fs_open  (ptr, i64, i64) -> i64 # path, path length, access (0 read, 1 read-write creating, 2 create new) -> handle above 0, or a failure below 0
klf.fs.close  klfsvc_fs_close  (i64) -> i64 # handle -> 1 when closed, or a failure below 0
klf.fs.close_descriptor  klfsvc_fs_close_descriptor  (i64) -> i64 # OS descriptor a library handed the program -> 1 when closed, -4 when not open or not on this host, or a failure below 0
klf.fs.read_at  klfsvc_fs_read_at  (i64, i64, ptr, i64) -> i64 # handle, offset, destination, count -> bytes read (fewer only at the end), or a failure below 0
klf.fs.write_at  klfsvc_fs_write_at  (i64, i64, ptr, i64) -> i64 # handle, offset, bytes, count -> count when all written, or a failure below 0
klf.fs.sync  klfsvc_fs_sync  (i64) -> i64 # handle -> 1 when the data is durable, or a failure below 0
klf.fs.truncate  klfsvc_fs_truncate  (i64, i64) -> i64 # handle, size -> 1 when resized, or a failure below 0
klf.fs.handle_size  klfsvc_fs_handle_size  (i64) -> i64 # handle -> size in bytes, or a failure below 0
klf.fs.lock  klfsvc_fs_lock  (i64, i64) -> i64 # handle, wait (1 waits for it) -> 1 when this process holds the file's exclusive lock, 0 when another holds it and wait is 0, or a failure below 0
klf.fs.sync_directory  klfsvc_fs_sync_directory  (ptr, i64) -> i64 # path, path length -> 1 when the entries are durable, or a failure below 0
klf.fs.status  klfsvc_fs_status  (ptr, i64, i64, ptr) -> i64 # path, path length, follow links (1), record of 6 words: kind (1 file, 2 directory, 3 link, 4 other), size, permission bits, modification nanoseconds, device, inode -> 1, or a failure below 0
klf.fs.set_mode  klfsvc_fs_set_mode  (ptr, i64, i64) -> i64 # path, path length, permission bits -> 1, or a failure below 0
klf.fs.symbolic_link  klfsvc_fs_symbolic_link  (ptr, i64, ptr, i64) -> i64 # target, target length, path, path length -> 1, or a failure below 0
klf.fs.read_link  klfsvc_fs_read_link  (ptr, i64, ptr, i64) -> i64 # path, path length, destination, capacity -> length of the target, copied only when it fits, or a failure below 0
klf.fs.hard_link  klfsvc_fs_hard_link  (ptr, i64, ptr, i64) -> i64 # from, from length, to, to length -> 1, or a failure below 0
klf.fs.copy  klfsvc_fs_copy  (ptr, i64, ptr, i64) -> i64 # from, from length, to, to length -> bytes copied with the permission bits, or a failure below 0
klf.fs.set_length  klfsvc_fs_set_length  (ptr, i64, i64) -> i64 # path, path length, length -> 1 when the file has that length, created when missing, or a failure below 0
klf.net.udp_bind  klfsvc_net_udp_bind  (ptr, i64) -> i64 # address text, length -> socket handle above 0, or a failure below 0 (D-384)
klf.net.udp_send  klfsvc_net_udp_send  (i64, ptr, i64, ptr, i64) -> i64 # socket, peer address text, length, bytes, count -> bytes sent, or a failure below 0
klf.net.udp_receive  klfsvc_net_udp_receive  (i64, ptr, i64, ptr, i64) -> i64 # socket, destination, capacity, peer destination, capacity -> bytes received, the peer written as NUL-ended text when it fits, or a failure below 0
klf.net.tcp_connect  klfsvc_net_tcp_connect  (ptr, i64) -> i64 # address text, length -> stream handle at once, connecting goes on until the poller reports writable or error
klf.net.unix_connect  klfsvc_net_unix_connect  (ptr, i64) -> i64 # socket path, length -> stream handle that sends, receives, shuts down and is watched as a TCP stream, or a failure below 0 (D-387)
klf.net.tcp_listen  klfsvc_net_tcp_listen  (ptr, i64, i64) -> i64 # address text, length, backlog -> listener handle, or a failure below 0
klf.net.tcp_accept  klfsvc_net_tcp_accept  (i64, ptr, i64) -> i64 # listener, peer destination, capacity -> stream handle, the peer written as NUL-ended text when it fits, or a failure below 0
klf.net.tcp_send  klfsvc_net_tcp_send  (i64, ptr, i64) -> i64 # stream, bytes, count -> bytes the stream accepted, or a failure below 0
klf.net.tcp_receive  klfsvc_net_tcp_receive  (i64, ptr, i64) -> i64 # stream, destination, capacity -> bytes read, 0 at the peer's end, or a failure below 0
klf.net.tcp_shutdown  klfsvc_net_tcp_shutdown  (i64) -> i64 # stream -> 1 when its write side is closed, or a failure below 0
klf.net.local_address  klfsvc_net_local_address  (i64, ptr, i64) -> i64 # socket, destination, capacity -> length of its bound address text, written NUL-ended when it fits
klf.net.close  klfsvc_net_close  (i64) -> i64 # socket, poller or lookup -> 1 when released, or a failure below 0
klf.net.poller_create  klfsvc_net_poller_create  () -> i64 # -> poller handle, or a failure below 0
klf.net.poller_watch  klfsvc_net_poller_watch  (i64, i64, i64, i64) -> i64 # poller, socket, interest bits (1 readable, 2 writable, 0 none), token -> 1 when watched
klf.net.poller_wait  klfsvc_net_poller_wait  (i64, i64, ptr, i64) -> i64 # poller, timeout ns (negative forever), destination, capacity in events -> events written, each token then bits (1 readable, 2 writable, 4 peer closed, 8 error, 16 resolved, 32 woken as token 0); readiness is reported when it changes
klf.net.poller_wake  klfsvc_net_poller_wake  (i64) -> i64 # poller -> 1; ends a wait from any thread
klf.net.resolve  klfsvc_net_resolve  (i64, ptr, i64, i64) -> i64 # poller, host name, length, token -> lookup handle; the poller reports the token resolved when it finishes
klf.net.resolved  klfsvc_net_resolved  (i64, ptr, i64) -> i64 # lookup, destination, capacity -> length of its NUL-ended addresses without ports, copied only when they fit; -1 while running, -9 not found
klf.crypto.random  klfsvc_crypto_random  (ptr, i64) -> i64 # destination, count -> 1 when filled from the OS generator (D-385)
klf.crypto.digest  klfsvc_crypto_digest  (i64, ptr, i64, ptr, i64) -> i64 # hash (4 SHA-256, 5 SHA-384), data, count, destination, capacity -> digest length, or a failure below 0
klf.crypto.hmac  klfsvc_crypto_hmac  (i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # hash, key, length, data, count, destination, capacity -> tag length
klf.crypto.hkdf_extract  klfsvc_crypto_hkdf_extract  (i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # hash, salt, length, input keying material, length, destination, capacity -> pseudorandom key length (RFC 5869)
klf.crypto.hkdf_expand  klfsvc_crypto_hkdf_expand  (i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # hash, pseudorandom key, length, info, length, destination, length -> the length, all of it filled
klf.crypto.aead_seal  klfsvc_crypto_aead_seal  (i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64, i64) -> i64 # TLS cipher suite, key, length, nonce, length, associated data, length, buffer, plaintext count, capacity -> sealed length, the tag after the ciphertext in place
klf.crypto.aead_open  klfsvc_crypto_aead_open  (i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # TLS cipher suite, key, length, nonce, length, associated data, length, buffer, sealed count -> plaintext length in place, -3 when the tag does not verify
klf.crypto.header_mask  klfsvc_crypto_header_mask  (i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # TLS cipher suite, header key, length, sample, length, destination, capacity -> 5, the QUIC header-protection mask (RFC 9001 5.4)
klf.crypto.agreement_create  klfsvc_crypto_agreement_create  (i64, ptr, i64) -> i64 # TLS group (0x001d X25519, 0x0017 secp256r1), public key destination, capacity -> private key handle
klf.crypto.agreement_finish  klfsvc_crypto_agreement_finish  (i64, ptr, i64, ptr, i64) -> i64 # private key handle, peer public key, length, destination, capacity -> shared secret length; the handle is released
klf.crypto.verify  klfsvc_crypto_verify  (i64, ptr, i64, ptr, i64, ptr, i64) -> i64 # TLS signature scheme, DER certificate, length, message, length, signature, length -> 1 when its key made the signature, -3 when not
klf.crypto.key_load  klfsvc_crypto_key_load  (ptr, i64) -> i64 # PKCS#8 DER private key, length -> signing key handle
klf.crypto.sign  klfsvc_crypto_sign  (i64, i64, ptr, i64, ptr, i64) -> i64 # signing key handle, TLS signature scheme, message, length, destination, capacity -> signature length
klf.crypto.certificate_verify  klfsvc_crypto_certificate_verify  (ptr, i64, ptr, i64, i64, ptr, i64) -> i64 # certificates each behind a 24-bit length, end entity first, length, server name, length, Unix seconds, extra trust anchors in the same form, length -> 1 when it chains to a bundled Mozilla root or an extra anchor and names the server
klf.crypto.release  klfsvc_crypto_release  (i64) -> i64 # key handle -> 1 when released
klf.crypto.digest_file  klfsvc_crypto_digest_file  (i64, ptr, i64, ptr, i64) -> i64 # hash, path, path length, destination, capacity -> digest length of the file's bytes, or a failure below 0
klf.crypto.key_generate  klfsvc_crypto_key_generate  (i64, ptr, i64) -> i64 # scheme (0x0807 Ed25519), destination, capacity -> length of a new PKCS#8 DER key, or a failure below 0
klf.crypto.key_public  klfsvc_crypto_key_public  (i64, ptr, i64) -> i64 # key handle, destination, capacity -> length of the raw public key, or a failure below 0
klf.process.argument_count  klfsvc_process_argument_count  () -> i64 # argument count, executable path excluded
klf.process.argument  klfsvc_process_argument  (i64, ptr, i64) -> i64 # index, destination, capacity -> byte length, -1 past end
klf.process.invoked_as  klfsvc_process_invoked_as  (ptr, i64) -> i64 # destination, capacity -> byte length of the path the program was started as, copied only when it fits
klf.process.command_push  klfsvc_process_command_push  (ptr, i64) -> i64 # append one command argument
klf.process.command_run  klfsvc_process_command_run  (i64) -> i64 # 1 capture, 0 attached -> exit status, -1 no status, -2 failed to start
klf.process.output  klfsvc_process_output  (i64, ptr, i64) -> i64 # stream 1/2, destination, capacity -> captured byte length
klf.process.spawn_create  klfsvc_process_spawn_create  () -> i64 # -> handle of an empty command
klf.process.spawn_argument  klfsvc_process_spawn_argument  (i64, ptr, i64) -> i64 # command, bytes, count -> 1, or a failure below 0; the first is the program
klf.process.spawn_environment  klfsvc_process_spawn_environment  (i64, ptr, i64) -> i64 # command, NAME=value bytes, count -> 1, or a failure below 0
klf.process.spawn_clear_environment  klfsvc_process_spawn_clear_environment  (i64) -> i64 # command -> 1; the child starts from an empty environment
klf.process.spawn_directory  klfsvc_process_spawn_directory  (i64, ptr, i64) -> i64 # command, path, path length -> 1, or a failure below 0
klf.process.spawn_stream  klfsvc_process_spawn_stream  (i64, i64, i64, ptr, i64) -> i64 # command, stream 0/1/2, mode (0 inherit, 1 null, 2 pipe, 3 file), path, path length -> 1, or a failure below 0
klf.process.spawn_start  klfsvc_process_spawn_start  (i64) -> i64 # command -> child handle, or a failure below 0; the command is released
klf.process.child_wait  klfsvc_process_child_wait  (i64, i64) -> i64 # child, timeout nanoseconds (negative waits forever) -> exit status, -200 minus the signal, -100 still running, or a failure
klf.process.child_wait_any  klfsvc_process_child_wait_any  (i64) -> i64 # timeout nanoseconds -> a child that ended, each answered once, or 0
klf.process.child_read  klfsvc_process_child_read  (i64, i64, ptr, i64, i64) -> i64 # child, stream 1/2, destination, capacity, timeout -> bytes read, 0 at the end, -101 none yet, or a failure
klf.process.child_write  klfsvc_process_child_write  (i64, ptr, i64) -> i64 # child, bytes, count -> count written to its piped input, or a failure below 0
klf.process.child_close_input  klfsvc_process_child_close_input  (i64) -> i64 # child -> 1 once its piped input is closed
klf.process.child_signal  klfsvc_process_child_signal  (i64, i64) -> i64 # child, signal (1 interrupt, 2 terminate, 3 kill) -> 1, or a failure below 0
klf.process.child_release  klfsvc_process_child_release  (i64) -> i64 # child -> 1 when forgotten
klf.process.current_directory  klfsvc_process_current_directory  (ptr, i64) -> i64 # destination, capacity -> length of the working directory, copied only when it fits
klf.process.processor_count  klfsvc_process_processor_count  () -> i64 # -> threads the host runs at once for this process, at least 1 (D-388)
klf.process.exit  klfsvc_process_exit  (i64) -> void # status: runs the exit function with reason 0 and ends the process
klf.time.monotonic  klfsvc_time_monotonic  () -> i64 # nanoseconds since the first clock read in this process, never decreasing
klf.time.wall  klfsvc_time_wall  () -> i64 # nanoseconds since the Unix epoch
klf.time.sleep  klfsvc_time_sleep  (i64) -> void # pause the calling thread for at least this many nanoseconds, none when not positive
klf.thread.spawn  klfsvc_thread_spawn  (ptr, i64) -> i64 # entry void(*)(int64_t), argument -> handle above 0, or a failure below 0; the VM refuses
klf.thread.join  klfsvc_thread_join  (i64) -> i64 # handle -> 1 once the thread ended, or a failure below 0
klf.thread.detach  klfsvc_thread_detach  (i64) -> i64 # handle -> 1, the thread runs on unjoined, or a failure below 0
klf.thread.current  klfsvc_thread_current  () -> i64 # the calling thread's number, above 0 and never reused
klf.thread.park  klfsvc_thread_park  (i64) -> i64 # timeout ns (negative forever) -> 1 when unparked, timed out or woken spuriously
klf.thread.unpark  klfsvc_thread_unpark  (i64) -> i64 # thread number -> 1, its park returns or its next one does, or a failure below 0
klf.thread.yield  klfsvc_thread_yield  () -> void # offer the processor to another thread
klf.thread.parallelism  klfsvc_thread_parallelism  () -> i64 # threads that can run at once, at least 1
klf.host.key_length  klfsvc_host_key_length  () -> i64 # byte length of this host's key
klf.host.key_copy  klfsvc_host_key_copy  (ptr, i64) -> i64 # destination, capacity -> the key's bytes, copied only when they fit
klf.runtime.at_exit  klfsvc_runtime_at_exit  (i64) -> i64 # function (reason, detail) run once as the program ends, 0 for none -> the one it replaces
klf.trap.operands  klfsvc_trap_operands  (i64, i64) -> void # the two values a failed check compared, which the report of the trap that follows names as {0} and {1}
klf.trap.text  klfsvc_trap_text  (ptr, i64) -> void # text the report of the trap that follows names as {text}, such as the type an `Any` held
klf.source.len   klfsvc_source_len   () -> i64       # length of the current source buffer
klf.source.byte  klfsvc_source_byte  (i64) -> i64    # read a source byte, zero out of range
klf.source.copy  klfsvc_source_copy  (ptr, i64) -> i64 # output buffer, byte length -> 1 when the whole source buffer was copied
klf.source.file_len  klfsvc_source_file_len  (i64, i64) -> i64  # session, source file -> its length
klf.source.file_byte klfsvc_source_file_byte (i64, i64, i64) -> i64 # session, source file, offset
klf.source.file_copy klfsvc_source_file_copy (i64, i64, ptr, i64) -> i64 # session, source file, output buffer, byte length -> 1 when copied
klf.source.file_name_len klfsvc_source_file_name_len (i64, i64) -> i64 # session, source file -> name length
klf.source.file_name_byte klfsvc_source_file_name_byte (i64, i64, i64) -> i64 # session, source file, name offset
klf.source.file_name_copy klfsvc_source_file_name_copy (i64, i64, ptr, i64) -> i64 # session, source file, output buffer, byte length -> 1 when copied
klf.source.name_len klfsvc_source_name_len () -> i64 # current source name length
klf.source.name_byte klfsvc_source_name_byte (i64) -> i64 # current source name byte
klf.source.name_copy klfsvc_source_name_copy (ptr, i64) -> i64 # output buffer, byte length -> 1 when the current source name was copied
klf.source.named_exists klfsvc_source_named_exists (ptr, i64) -> i64 # source name buffer, byte length -> present
klf.source.named_len klfsvc_source_named_len (ptr, i64) -> i64 # source name buffer, byte length -> source length
klf.source.named_byte klfsvc_source_named_byte (ptr, i64, i64) -> i64 # source name buffer, byte length, offset
klf.source.named_copy klfsvc_source_named_copy (ptr, i64, ptr, i64) -> i64 # source name buffer, byte length, output buffer, byte length -> 1 when copied
klf.source.path_exists klfsvc_source_path_exists (i64, ptr, i64) -> i64 # session, path buffer, byte length -> 1 when a file or directory is there, else 0 (D-327)
klf.source.read klfsvc_source_read (i64, ptr, i64) -> i64 # session, path buffer, byte length -> source file or -1 (section 8.1 Session.read)
klf.source.directory klfsvc_source_directory (i64, ptr, i64, ptr, i64) -> i64 # session, directory, length, extension, length -> files read or -1
klf.source.directory_file klfsvc_source_directory_file (i64, i64) -> i64 # session, index -> source file of the last directory read
klf.session.flag klfsvc_session_flag (i64, ptr, i64, ptr) -> i64 # session, name buffer, byte length, output [tag, value-or-length]
klf.session.flag_string_copy klfsvc_session_flag_string_copy (i64, ptr, i64, ptr, i64) -> i64 # session, name buffer, byte length, output buffer, output byte length
klf.session.std_root_len klfsvc_session_std_root_len (i64) -> i64 # session -> byte length of the std source directory, empty when unknown (D-327)
klf.session.std_root_copy klfsvc_session_std_root_copy (i64, ptr, i64) -> i64 # session, output buffer, byte length -> 1 when copied (D-327)
klf.session.target_len klfsvc_session_target_len (i64) -> i64 # session -> byte length of the target triple (D-327)
klf.session.target_copy klfsvc_session_target_copy (i64, ptr, i64) -> i64 # session, output buffer, byte length -> 1 when copied (D-327)
klf.session.file_mode klfsvc_session_file_mode (i64, i64) -> i64 # session, source file -> selected zero-based file mode or -1
klf.session.file_memory klfsvc_session_file_memory (i64, i64) -> i64 # session, source file -> effective MemoryModel tag
klf.session.file_convention klfsvc_session_file_convention (i64, i64) -> i64 # session, source file -> effective DefaultConvention tag
klf.editor.mode klfsvc_editor_mode () -> i64 # 1 when the session serves an editor, 0 in a build (KLF-EDITOR 6.2)
klf.editor.project_field klfsvc_editor_project_field (i64, ptr, i64) -> i64 # field (0 name, 1 root, 2 argument, 3 watch, 4 output), text, length -> 1 in a project hook call (KLF-EDITOR 5.3)
klf.editor.classify klfsvc_editor_classify (i64, i64, i64, i64, i64) -> i64 # file or -1, start, end, TokenClass, TokenModifier bits -> 1 when recorded
klf.editor.classify_many klfsvc_editor_classify_many (i64, ptr, i64) -> i64 # file or -1, tokens of four words (start, end, class, modifiers), count -> tokens recorded
klf.editor.symbol klfsvc_editor_symbol (i64, i64, i64, i64, i64, i64, i64, i64) -> i64 # entity, file, start, end, name start, name end, SymbolKind, container or -1
klf.editor.symbol_text klfsvc_editor_symbol_text (i64, i64, ptr, i64) -> i64 # entity, field (0 name, 1 signature, 2 documentation, 3 detail, 4 parameter), text, length
klf.editor.symbol_flags klfsvc_editor_symbol_flags (i64, i64) -> i64 # entity, bits: 1 deprecated, 2 exported, 4 local
klf.editor.declaration klfsvc_editor_declaration (i64, i64, i64, i64, i64, i64) -> i64 # entity, file, start, end, name start, name end
klf.editor.reference klfsvc_editor_reference (i64, i64, i64, i64, i64) -> i64 # file, start, end, entity, ReferenceRole
klf.editor.unresolved klfsvc_editor_unresolved (i64, i64, i64) -> i64 # file, start, end of a name that resolved to nothing
klf.editor.scope klfsvc_editor_scope (i64, i64, i64, i64) -> i64 # file, start, end, scope key
klf.editor.type_at klfsvc_editor_type_at (i64, i64, i64, i64, ptr, i64) -> i64 # file, start, end, type entity or -1, text, length
klf.editor.value_at klfsvc_editor_value_at (i64, i64, i64, ptr, i64) -> i64 # file, start, end, text, length
klf.editor.hint klfsvc_editor_hint (i64, i64, i64, i64, i64, ptr, i64) -> i64 # file, offset, HintKind, bits (1 pad left, 2 pad right), target or -1, label[NUL insert], length
klf.editor.fold klfsvc_editor_fold (i64, i64, i64, i64) -> i64 # file, start, end, FoldKind
klf.editor.node klfsvc_editor_node (i64, i64, i64) -> i64 # file, start, end of a syntax node
klf.editor.link klfsvc_editor_link (i64, i64, i64, i64, i64, ptr, i64) -> i64 # file, start, end, kind (0 file, 1 url, 2 entity), entity, text, length
klf.editor.runnable klfsvc_editor_runnable (i64, i64, i64, i64, ptr, i64) -> i64 # file, start, end, RunnableKind, label and driver arguments NUL-separated, length
klf.editor.call_edge klfsvc_editor_call_edge (i64, i64, i64, i64, i64) -> i64 # caller, callee, file, start, end
klf.editor.type_edge klfsvc_editor_type_edge (i64, i64) -> i64 # subtype, supertype
klf.editor.inactive klfsvc_editor_inactive (i64, i64, i64) -> i64 # file, start, end of source a condition excluded
