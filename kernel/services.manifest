# The reader and writer an out uses (KLF-KSL section 6.7). A unit is the one
# the driver is emitting; a text answer is a text id, -1 for absent.
klf.shader.read.count klfsvc_shader_read_count (i64, ptr, i64, i64) -> i64 # unit, table, owner -> how many records
