klf.shader.type.align klfsvc_shader_type_align (i64, i64, ptr, i64) -> i64 # module, type, layout rule -> alignment
klf.shader.constant klfsvc_shader_constant (i64, ptr, i64, i64, i64) -> i64 # module, name, type, global expression -> constant
klf.shader.override klfsvc_shader_override (i64, ptr, i64, i64, i64, i64) -> i64 # module, name, id (-1 none), type, default (-1 none) -> override
