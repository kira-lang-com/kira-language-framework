klf.kir.type.unique   klfsvc_kir_type_unique   (i64) -> i64 # pointee type -> unique owning type
klf.kir.type.array   klfsvc_kir_type_array   (i64, i64) -> i64 # length, element type -> type
klf.kir.type.size   klfsvc_kir_type_size   (i64, i64) -> i64 # module, concrete type -> byte size from shared layout rules
klf.kir.type.align   klfsvc_kir_type_align   (i64, i64) -> i64 # module, concrete type -> byte alignment from shared layout rules
klf.kir.type.unit   klfsvc_kir_type_unit   () -> i64 # -> unit type
klf.kir.function.define   klfsvc_kir_function_define   (i64, i64, i64, i64) -> i64 # module, name start, end, result type
klf.kir.function.result   klfsvc_kir_function_result   (i64, i64) -> void # function, value
