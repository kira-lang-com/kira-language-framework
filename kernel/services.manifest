klf.shader.read.int klfsvc_shader_read_int (i64, ptr, i64, i64, i64, ptr, i64, i64) -> i64 # unit, table, owner, index, field, item (-1 the count) -> the value, -1 absent
klf.shader.read.text klfsvc_shader_read_text (i64, ptr, i64, i64, i64, ptr, i64, i64) -> i64 # unit, table, owner, index, field, item (-1 the count) -> a text id, -1 absent
