# General low-level KIR builder (language-agnostic). A definition composes an
# arbitrary KIR type through a handle, then builds typed values and memory
# against it. No hosted language's type mapping is encoded here.
klf.kir.type.integer   klfsvc_kir_type_integer   (i64) -> i64 # bits -> type
klf.kir.type.float     klfsvc_kir_type_float     (i64) -> i64 # bits -> type
