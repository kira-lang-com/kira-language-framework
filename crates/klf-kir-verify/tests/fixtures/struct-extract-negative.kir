module @BadExtract lang "test" target "aarch64-apple-darwin" stage raw

type %Pair = struct ridl { first: i64, second: i64 }
policy { copy: trivial, destroy: trivial, relocate: bitwise, exclusivity: static, pairing: none }

func private @bad(%pair: borrow %Pair) -> i64 engine(runtime) {
bb0(%pair: borrow %Pair):
  %missing = struct.extract %pair, 2
  return %missing
}
