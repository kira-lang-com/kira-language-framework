construct Calc() extends Language<Tree, Program> {
    let name: String = "calc"
    let driver: String = "calc"
    let version: String = "0.1.0"
    let extensions: [String] = ["calc"]
    let memory: MemoryModel = .Counted
    let exclusivity: Exclusivity = .None
    let convention: DefaultConvention = .Platform
    let stdRoot: String = ""
}

struct Parser {
    let pos: Int
}

function skip(p: Parser) {
    while p.pos < source_len() {
        let c = source_byte(p.pos)
        if c == (32 as U8) {
            p.pos = p.pos + 1
        } else if c == (9 as U8) {
            p.pos = p.pos + 1
        } else if c == (10 as U8) {
            p.pos = p.pos + 1
        } else {
            return
        }
    }
}

function number(p: Parser) -> Int {
    skip(p)
    var value = 0
    while p.pos < source_len() {
        let c = source_byte(p.pos)
        if c < (48 as U8) {
            return value
        } else if c > (57 as U8) {
            return value
        }
        value = value * 10 + (c as Int) - 48
        p.pos = p.pos + 1
    }
    return value
}

function factor(p: Parser) -> Int {
    skip(p)
    let c = source_byte(p.pos)
    if c == (40 as U8) {
        p.pos = p.pos + 1
        let value = expression(p)
        skip(p)
        p.pos = p.pos + 1
        return value
    }
    return number(p)
}

function term(p: Parser) -> Int {
    var value = factor(p)
    while p.pos < source_len() {
        skip(p)
        let c = source_byte(p.pos)
        if c != (42 as U8) {
            return value
        }
        p.pos = p.pos + 1
        value = value * factor(p)
    }
    return value
}

function expression(p: Parser) -> Int {
    var value = term(p)
    while p.pos < source_len() {
        skip(p)
        let c = source_byte(p.pos)
        if c == (43 as U8) {
            p.pos = p.pos + 1
            value = value + term(p)
        } else if c == (45 as U8) {
            p.pos = p.pos + 1
            value = value - term(p)
        } else {
            return value
        }
    }
    return value
}

function main() -> Int {
    var parser = Parser { pos = 0 }
    let result = expression(parser)
    puti(result)
    return result
}
